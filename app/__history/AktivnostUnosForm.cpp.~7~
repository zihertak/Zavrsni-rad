__fastcall Tform_aktivnost_unos::Tform_aktivnost_unos(TComponent* Owner)
	: TForm(Owner),
	  idAktivnost(0)
{
}
//---------------------------------------------------------------------------
void Tform_aktivnost_unos::ucitajPodrucja()
{
	check_podrucja->Items->Clear();

	query_podrucja->Close();
	query_podrucja->SQL->Clear();

	query_podrucja->SQL->Add(
		"SELECT "
		"id_podrucje_razvoja, "
		"naziv "
		"FROM podrucje_razvoja "
		"ORDER BY naziv ASC"
	);

	query_podrucja->Open();

	while (!query_podrucja->Eof)
	{
		String naziv =
			query_podrucja
				->FieldByName("naziv")
				->AsString;

		int idPodrucje =
			query_podrucja
				->FieldByName("id_podrucje_razvoja")
				->AsInteger;

		check_podrucja->Items->AddObject(
			naziv,
			reinterpret_cast<TObject*>(
				static_cast<NativeInt>(idPodrucje)
			)
		);

		query_podrucja->Next();
	}
}

void Tform_aktivnost_unos::pripremiZaDodavanje()
{
	idAktivnost = 0;
	Caption = "Dodavanje aktivnosti";
	edit_naziv->Clear();
	memo_opis->Clear();
	edit_trajanje->Clear();
	edit_dob_od->Clear();
	edit_dob_do->Clear();
	memo_potrebne_stavke->Clear();
	memo_upute->Clear();
	ucitajPodrucja();
}

void Tform_aktivnost_unos::pripremiZaUredjivanje(
	int odabraniIdAktivnost)
{
	idAktivnost = odabraniIdAktivnost;
	Caption = "Uređivanje aktivnosti";
	ucitajPodrucja();
	query_aktivnost->Close();

	query_aktivnost->SQL->Clear();

	query_aktivnost->SQL->Add(
		"SELECT * "
		"FROM aktivnost "
		"WHERE id_aktivnost = :id"
	);

	query_aktivnost
		->ParamByName("id")
		->AsInteger =
		idAktivnost;

	query_aktivnost->Open();
    if (query_aktivnost->IsEmpty())
	{
	ShowMessage(
		L"Aktivnost nije pronađena."
	);

	return;
	}
    edit_naziv->Text =
	query_aktivnost
		->FieldByName("naziv")
		->AsString;

	memo_opis->Text =
		query_aktivnost
			->FieldByName("opis")
			->AsString;

	edit_trajanje->Text =
		query_aktivnost
			->FieldByName("trajanje_minuta")
			->AsString;

	edit_dob_od->Text =
		query_aktivnost
			->FieldByName("dob_od")
			->AsString;

	edit_dob_do->Text =
		query_aktivnost
			->FieldByName("dob_do")
			->AsString;

	memo_potrebne_stavke->Text =
		query_aktivnost
			->FieldByName("potrebne_stavke")
			->AsString;

	memo_upute->Text =
		query_aktivnost
			->FieldByName("upute")
		->AsString;
}
void __fastcall Tform_aktivnost_unos::button_odustaniClick(TObject *Sender)
{
	ModalResult = mrCancel;
}
//---------------------------------------------------------------------------
void __fastcall Tform_aktivnost_unos::button_spremiClick(TObject *Sender)
{
    String naziv = edit_naziv->Text.Trim();
	String opis = memo_opis->Text.Trim();
	String trajanjeTekst = edit_trajanje->Text.Trim();
	String dobOdTekst = edit_dob_od->Text.Trim();
	String dobDoTekst = edit_dob_do->Text.Trim();

	if (naziv.IsEmpty())
	{
		ShowMessage(L"Unesite naziv aktivnosti.");
		edit_naziv->SetFocus();
		return;
	}

	if (trajanjeTekst.IsEmpty())
	{
		ShowMessage(L"Unesite trajanje aktivnosti.");
		edit_trajanje->SetFocus();
		return;
	}

	if (dobOdTekst.IsEmpty())
	{
		ShowMessage(L"Unesite minimalnu dob.");
		edit_dob_od->SetFocus();
		return;
	}

	if (dobDoTekst.IsEmpty())
	{
		ShowMessage(L"Unesite maksimalnu dob.");
		edit_dob_do->SetFocus();
		return;
	}

	int trajanje = StrToInt(trajanjeTekst);
	int dobOd = StrToInt(dobOdTekst);
	int dobDo = StrToInt(dobDoTekst);

	if (trajanje <= 0)
	{
		ShowMessage(L"Trajanje mora biti veće od 0 minuta.");
		edit_trajanje->SetFocus();
		return;
	}

	if (dobOd < 0)
	{
		ShowMessage(L"Minimalna dob ne može biti negativna.");
		edit_dob_od->SetFocus();
		return;
	}

	if (dobDo < dobOd)
	{
		ShowMessage(
			L"Maksimalna dob mora biti jednaka ili veća "
			L"od minimalne dobi."
		);
		edit_dob_do->SetFocus();
		return;
	}
	bool odabrano = false;

	for (int i = 0; i < check_podrucja->Items->Count; i++)
	{
		if (check_podrucja->Checked[i])
		{
			odabrano = true;
			break;
		}
	}

	if (!odabrano)
	{
		ShowMessage(
			L"Odaberite barem jedno područje razvoja."
		);

		return;
	}


	try
	{
		data_module->connection->StartTransaction();
		query_spremanje->Close();
		query_spremanje->SQL->Clear();

		query_spremanje->SQL->Add(
			"INSERT INTO aktivnost "
			"(naziv, opis, trajanje_minuta, dob_od, dob_do, "
			"potrebne_stavke, upute) "
			"VALUES "
			"(:naziv, :opis, :trajanje_minuta, :dob_od, :dob_do, "
			":potrebne_stavke, :upute)"
		);

		query_spremanje
			->ParamByName("naziv")
			->AsString =
			naziv;

		query_spremanje
			->ParamByName("opis")
			->AsString =
			opis;

		query_spremanje
			->ParamByName("trajanje_minuta")
			->AsInteger =
			trajanje;

		query_spremanje
			->ParamByName("dob_od")
			->AsInteger =
			dobOd;

		query_spremanje
			->ParamByName("dob_do")
			->AsInteger =
			dobDo;

		query_spremanje
			->ParamByName("potrebne_stavke")
			->AsString =
			memo_potrebne_stavke->Text.Trim();

		query_spremanje
			->ParamByName("upute")
			->AsString =
			memo_upute->Text.Trim();

		query_spremanje->ExecSQL();

        query_spremanje->Close();
		query_spremanje->SQL->Clear();

		query_spremanje->SQL->Add(
			"SELECT LAST_INSERT_ID() AS novi_id"
		);

		query_spremanje->Open();

		int noviIdAktivnost =
		query_spremanje
		->FieldByName("novi_id")
		->AsInteger;

        for (int i = 0; i < check_podrucja->Items->Count; i++)
		{
		if (!check_podrucja->Checked[i])
			continue;

		int idPodrucje =
			static_cast<int>(
				reinterpret_cast<NativeInt>(
					check_podrucja->Items->Objects[i]
				)
			);

		query_spremanje->Close();
		query_spremanje->SQL->Clear();

		query_spremanje->SQL->Add(
			"INSERT INTO aktivnost_podrucje "
			"(id_aktivnost, id_podrucje_razvoja) "
			"VALUES "
			"(:id_aktivnost, :id_podrucje)"
		);

		query_spremanje
			->ParamByName("id_aktivnost")
			->AsInteger =
			noviIdAktivnost;

		query_spremanje
			->ParamByName("id_podrucje")
			->AsInteger =
			idPodrucje;

		query_spremanje->ExecSQL();
		}

		data_module->connection->Commit();
		ShowMessage(L"Aktivnost je uspješno spremljena.");

		ModalResult = mrOk;
	}
	catch (const Exception &e)
	{
        if (data_module->connection->InTransaction)
		{
			data_module->connection->Rollback();
		}
		ShowMessage(
			L"Došlo je do pogreške pri spremanju aktivnosti:\n" +
			e.Message
		);
	}
}
