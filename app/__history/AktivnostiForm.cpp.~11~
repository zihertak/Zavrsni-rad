void Tform_aktivnosti::ucitajPodrucja()
{
	combo_podrucje->Items->Clear();
	combo_podrucje->Items->Add(L"Sva područja");

	query_podrucja->Close();
	query_podrucja->SQL->Clear();

	query_podrucja->SQL->Add(
		"SELECT id_podrucje_razvoja, naziv "
		"FROM podrucje_razvoja "
		"ORDER BY naziv ASC"
	);

	query_podrucja->Open();

	while (!query_podrucja->Eof)
	{
		combo_podrucje->Items->Add(
			query_podrucja
				->FieldByName("naziv")
				->AsString
		);

		query_podrucja->Next();
	}

	combo_podrucje->ItemIndex = 0;
}
//---------------------------------------------------------------------------
void Tform_aktivnosti::osvjeziPopisAktivnosti()
{
	String pretraga = edit_pretraga->Text.Trim();
	String podrucje = "";

	if (combo_podrucje->ItemIndex > 0)
	{
		podrucje = combo_podrucje->Text;
	}

	query_aktivnosti->Close();
	query_aktivnosti->SQL->Clear();

	query_aktivnosti->SQL->Add(
		"SELECT "
		"a.id_aktivnost, "
		"a.naziv, "
		"CAST(a.opis AS CHAR(255)) AS opis, "
		"a.trajanje_minuta, "
		"a.dob_od, "
		"a.dob_do, "

		"GROUP_CONCAT("
		"DISTINCT pr.naziv "
		"ORDER BY pr.naziv "
		"SEPARATOR ', '"
		") AS podrucja_razvoja "

		"FROM aktivnost a "

		"LEFT JOIN aktivnost_podrucje apr "
		"ON apr.id_aktivnost = a.id_aktivnost "

		"LEFT JOIN podrucje_razvoja pr "
		"ON pr.id_podrucje_razvoja = apr.id_podrucje_razvoja "

		"WHERE 1 = 1 "
	);

	if (!pretraga.IsEmpty())
	{
		query_aktivnosti->SQL->Add(
			"AND ("
			"a.naziv LIKE :pretraga "
			"OR a.opis LIKE :pretraga "
			"OR pr.naziv LIKE :pretraga"
			") "
		);

		query_aktivnosti
			->ParamByName("pretraga")
			->AsString =
			"%" + pretraga + "%";
	}

	if (!podrucje.IsEmpty())
	{
		query_aktivnosti->SQL->Add(
			"AND pr.naziv = :podrucje "
		);

		query_aktivnosti
			->ParamByName("podrucje")
			->AsString =
			podrucje;
	}

	query_aktivnosti->SQL->Add(
		"GROUP BY "
		"a.id_aktivnost, "
		"a.naziv, "
		"a.opis, "
		"a.trajanje_minuta, "
		"a.dob_od, "
		"a.dob_do "

		"ORDER BY a.naziv ASC"
	);

	query_aktivnosti->Open();

	postaviIzgledGrida();
}

//---------------------------------------------------------------------------
void Tform_aktivnosti::postaviIzgledGrida()
{
	query_aktivnosti
		->FieldByName("id_aktivnost")
		->Visible = false;

	query_aktivnosti
		->FieldByName("naziv")
		->DisplayLabel = L"Naziv";

	query_aktivnosti
		->FieldByName("naziv")
		->DisplayWidth = 20;

	query_aktivnosti
		->FieldByName("opis")
		->DisplayLabel = L"Opis";

	query_aktivnosti
		->FieldByName("opis")
		->DisplayWidth = 30;

	query_aktivnosti
		->FieldByName("trajanje_minuta")
		->DisplayLabel = L"Trajanje (min)";

	query_aktivnosti
		->FieldByName("trajanje_minuta")
		->DisplayWidth = 14;

	query_aktivnosti
		->FieldByName("dob_od")
		->DisplayLabel = L"Dob od";

	query_aktivnosti
		->FieldByName("dob_od")
		->DisplayWidth = 8;

	query_aktivnosti
		->FieldByName("dob_do")
		->DisplayLabel = L"Dob do";

	query_aktivnosti
		->FieldByName("dob_do")
		->DisplayWidth = 8;

	query_aktivnosti
		->FieldByName("podrucja_razvoja")
		->DisplayLabel = L"Područja razvoja";

	query_aktivnosti
		->FieldByName("podrucja_razvoja")
		->DisplayWidth = 30;
}
