	combo_sortiranje->Items->Add(L"Naziv Ž-A");
	combo_sortiranje->Items->Add(L"Najkraće trajanje prvo");
	combo_sortiranje->Items->Add(L"Najduže trajanje prvo");
	combo_sortiranje->Items->Add(L"Najmlađa dob prvo");
	combo_sortiranje->Items->Add(L"Najstarija dob prvo");
	combo_sortiranje->ItemIndex = 0;

    osvjeziPopisAktivnosti();
}
