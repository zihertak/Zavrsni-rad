void Tform_skupine::primijeniPrava()
{
	TKorisnickaPrava prava(data_module->currentUserUloga);

	button_dodaj->Enabled =
		prava.dodajSkupinu();

	button_uredi->Enabled =
		prava.urediSkupinu();

	button_obrisi->Enabled =
		prava.obrisiSkupinu();

	button_korisnici->Visible =
		prava.korisnici();
}
