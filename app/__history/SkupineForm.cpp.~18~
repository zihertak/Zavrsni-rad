void Tform_skupine::ucitajPedagoskeGodine()
{
	combo_pedagoska_godina->Items->Clear();
	combo_pedagoska_godina->Items->Add(
		L"Sve godine"
	);
	query_pedagoske_godine->Close();
	query_pedagoske_godine->Open();
	while (!query_pedagoske_godine->Eof)
	{
		String pedagoskaGodina =
			query_pedagoske_godine
				->FieldByName("pedagoska_godina")
				->AsString;
		combo_pedagoska_godina->Items->Add(
			pedagoskaGodina
		);
		query_pedagoske_godine->Next();
	}
	combo_pedagoska_godina->ItemIndex = 0;
}

void Tform_skupine::osvjeziPopisSkupina()
{
	String pretraga = edit_pretraga->Text.Trim();
	String pedagoskaGodina = "";

	if (combo_pedagoska_godina->ItemIndex > 0)
	{
		pedagoskaGodina =
			combo_pedagoska_godina->Text;
	}

	query_skupine->Close();
	query_skupine->SQL->Clear();

	query_skupine->SQL->Add(
		"SELECT "
		"s.id_skupina, "
		"s.naziv, "
		"CONCAT(s.dob_od, ' - ', s.dob_do, ' godina') "
		"AS dobna_skupina, "
		"s.pedagoska_godina, "
		"s.dob_od, "
		"s.dob_do, "

		"(SELECT COUNT(*) "
		"FROM dijete d "
		"WHERE d.id_skupina = s.id_skupina) "
		"AS broj_djece, "

		"(SELECT GROUP_CONCAT("
		"CONCAT(k.ime, ' ', k.prezime) "
		"SEPARATOR ', ') "
		"FROM korisnik k "
		"INNER JOIN uloga u "
		"ON u.id_uloga = k.id_uloga "
		"WHERE k.id_skupina = s.id_skupina "
		"AND LOWER(u.naziv) = 'odgojitelj') "
		"AS odgojitelji "

		"FROM skupina s "
		"WHERE 1 = 1 "
	);

	if (!pretraga.IsEmpty())
	{
		query_skupine->SQL->Add(
			"AND s.naziv LIKE :pretraga "
		);

		query_skupine
			->ParamByName("pretraga")
			->AsString =
			"%" + pretraga + "%";
	}

	if (!pedagoskaGodina.IsEmpty())
	{
		query_skupine->SQL->Add(
			"AND s.pedagoska_godina = "
			":pedagoska_godina "
		);

		query_skupine
			->ParamByName("pedagoska_godina")
			->AsString =
			pedagoskaGodina;
	}

	switch (combo_sortiranje->ItemIndex)
	{
		case 0:
			query_skupine->SQL->Add(
				"ORDER BY s.naziv ASC"
			);
			break;

		case 1:
			query_skupine->SQL->Add(
				"ORDER BY s.naziv DESC"
			);
			break;

		case 2:
			query_skupine->SQL->Add(
				"ORDER BY s.dob_od ASC, s.dob_do ASC"
			);
			break;

		case 3:
			query_skupine->SQL->Add(
				"ORDER BY s.dob_od DESC, s.dob_do DESC"
			);
			break;

		case 4:
			query_skupine->SQL->Add(
				"ORDER BY s.pedagoska_godina ASC, "
				"s.naziv ASC"
			);
			break;

		case 5:
			query_skupine->SQL->Add(
				"ORDER BY s.pedagoska_godina DESC, "
				"s.naziv ASC"
			);
			break;

		default:
			query_skupine->SQL->Add(
				"ORDER BY s.naziv ASC"
			);
			break;
	}

	query_skupine->Open();

	postaviIzgledGrida();
}

void Tform_skupine::postaviIzgledGrida()
{
	query_skupine
		->FieldByName("id_skupina")
		->Visible = false;

	query_skupine
		->FieldByName("dob_od")
		->Visible = false;

	query_skupine
		->FieldByName("dob_do")
		->Visible = false;


	query_skupine
		->FieldByName("naziv")
		->DisplayLabel = L"Naziv";

	query_skupine
		->FieldByName("naziv")
		->DisplayWidth = 18;


	query_skupine
		->FieldByName("dobna_skupina")
		->DisplayLabel = L"Dobna skupina";

	query_skupine
		->FieldByName("dobna_skupina")
		->DisplayWidth = 18;


	query_skupine
		->FieldByName("pedagoska_godina")
		->DisplayLabel = L"Pedagoška godina";

	query_skupine
		->FieldByName("pedagoska_godina")
		->DisplayWidth = 20;


	query_skupine
		->FieldByName("broj_djece")
		->DisplayLabel = L"Broj djece";

	query_skupine
		->FieldByName("broj_djece")
		->DisplayWidth = 12;


	query_skupine
		->FieldByName("odgojitelji")
		->DisplayLabel = L"Odgojitelji";

	query_skupine
		->FieldByName("odgojitelji")
		->DisplayWidth = 30;
}
