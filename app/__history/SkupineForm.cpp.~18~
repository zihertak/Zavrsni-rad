void __fastcall Tform_skupine::button_dodajClick(TObject *Sender)
{
	TKorisnickaPrava prava(data_module->currentUserUloga);
    if (!prava.dodajSkupinu())
	{
	ShowMessage(L"Nemate pravo dodavanja skupina.");
	return;
	}
	form_skupina_unos->pripremiZaDodavanje();
	if (form_skupina_unos->ShowModal() == mrOk)
	{
		osvjeziPopisSkupina();
		ucitajPedagoskeGodine();
	}
}
//---------------------------------------------------------------------------

void __fastcall Tform_skupine::button_urediClick(TObject *Sender)
{
    TKorisnickaPrava prava(data_module->currentUserUloga);

	if (!prava.urediSkupinu())
	{
		ShowMessage(L"Nemate pravo uređivanja skupina.");
		return;
	}
    if (query_skupine->IsEmpty())
	{
		ShowMessage(L"Nema odabrane skupine za uređivanje.");
		return;
	}

	int idSkupine =
		query_skupine
			->FieldByName("id_skupina")
			->AsInteger;

	form_skupina_unos->pripremiZaUredjivanje(idSkupine);

	if (form_skupina_unos->ShowModal() == mrOk)
	{
		osvjeziPopisSkupina();
	}
}
//---------------------------------------------------------------------------

void __fastcall Tform_skupine::button_obrisiClick(TObject *Sender)
{
    TKorisnickaPrava prava(data_module->currentUserUloga);

	if (!prava.obrisiSkupinu())
	{
		ShowMessage(L"Nemate pravo brisanja skupina.");
		return;
	}
	if (query_skupine->IsEmpty())
	{
		ShowMessage(L"Nema odabrane skupine za brisanje.");
		return;
	}

	String nazivSkupine =
		query_skupine
			->FieldByName("naziv")
			->AsString;

	int odgovor = MessageDlg(
		L"Želite li zaista obrisati skupinu \"" +
		nazivSkupine +
		L"\"?",
		mtConfirmation,
		TMsgDlgButtons() << mbYes << mbNo,
		0
	);

	if (odgovor != mrYes)
	{
		return;
	}

	int idSkupine =
		query_skupine
			->FieldByName("id_skupina")
			->AsInteger;

	try
	{
		query_brisanje->Close();
		query_brisanje->SQL->Clear();

		query_brisanje->SQL->Add(
			"DELETE FROM skupina "
			"WHERE id_skupina = :id"
		);

		query_brisanje
			->ParamByName("id")
			->AsInteger = idSkupine;

		query_brisanje->ExecSQL();

		osvjeziPopisSkupina();
	}
	catch (Exception &e)
	{
		ShowMessage(
			L"Greška prilikom brisanja skupine:\n" +
			e.Message
		);
	}
}
