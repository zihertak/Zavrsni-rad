#pragma hdrstop

#include "DatabaseModule.h"
//---------------------------------------------------------------------------
#pragma package(smart_init)
#pragma classgroup "Vcl.Controls.TControl"
#pragma resource "*.dfm"
Tdata_module *data_module;
//---------------------------------------------------------------------------
__fastcall Tdata_module::Tdata_module(TComponent* Owner)
	: TDataModule(Owner)
{
}
//---------------------------------------------------------------------------
void __fastcall Tdata_module::DataModuleCreate(TObject *Sender)
{
try
    {
        connection->Connected = true;

        query_login->Close();
        query_login->Open();

        if (!query_login->IsEmpty())
        {
            String username = query_login->FieldByName("username")->AsString;

            ShowMessage("Prvi korisnik u bazi je: " + username);
        }
        else
        {
            ShowMessage("Tablica korisnik je prazna.");
        }

        query_login->Close();
        connection->Connected = false;
    }
    catch (const Exception &e)
    {
        ShowMessage("Greška pri čitanju baze: " + e.Message);
    }
}
