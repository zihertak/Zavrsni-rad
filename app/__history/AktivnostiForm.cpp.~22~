void __fastcall Tform_aktivnosti::button_dodajClick(TObject *Sender)
{
	TKorisnickaPrava prava(data_module->currentUserUloga);
	if (!prava.dodajAktivnost())
	{
	ShowMessage(
		L"Nemate pravo dodavanja aktivnosti."
	);

	return;
	}
    form_aktivnost_unos->pripremiZaDodavanje();
	if (form_aktivnost_unos->ShowModal() == mrOk)
	{
		osvjeziPopisAktivnosti();
	}
}
//---------------------------------------------------------------------------

void __fastcall Tform_aktivnosti::button_urediClick(TObject *Sender)
{
	TKorisnickaPrava prava(data_module->currentUserUloga);
	if (!prava.dodajAktivnost())
	{
	ShowMessage(
		L"Nemate pravo dodavanja aktivnosti."
	);

	return;
	}
    if (grid_aktivnosti->DataSource == nullptr)
		return;

	if (grid_aktivnosti->DataSource->DataSet->IsEmpty())
	{
		ShowMessage(
			L"Odaberite aktivnost."
		);

		return;
	}

	int idAktivnost =
		grid_aktivnosti
			->DataSource
			->DataSet
			->FieldByName("id_aktivnost")
			->AsInteger;

	form_aktivnost_unos
		->pripremiZaUredjivanje(idAktivnost);

	if (form_aktivnost_unos->ShowModal() == mrOk)
	{
		osvjeziPopisAktivnosti();
	}
}
//---------------------------------------------------------------------------

void __fastcall Tform_aktivnosti::button_obrisiClick(TObject *Sender)
{
	 TKorisnickaPrava prava(data_module->currentUserUloga);
	if (!prava.dodajAktivnost())
	{
	ShowMessage(
		L"Nemate pravo dodavanja aktivnosti."
	);

	return;
	}
    if (query_aktivnosti->IsEmpty())
	{
		ShowMessage(
			L"Odaberite aktivnost za brisanje."
		);

		return;
	}

	if (MessageDlg(
		L"Jeste li sigurni da želite obrisati odabranu aktivnost?",
		mtConfirmation,
		TMsgDlgButtons() << mbYes << mbNo,
		0
	) != mrYes)
	{
		return;
	}

	int idAktivnost =
		query_aktivnosti
			->FieldByName("id_aktivnost")
			->AsInteger;

	try
	{
	data_module->connection->StartTransaction();
    query_aktivnosti->Close();
		query_aktivnosti->SQL->Clear();

		query_aktivnosti->SQL->Add(
			"DELETE FROM aktivnost_podrucje "
			"WHERE id_aktivnost = :id"
		);

		query_aktivnosti
			->ParamByName("id")
			->AsInteger =
			idAktivnost;

		query_aktivnosti->ExecSQL();
        query_aktivnosti->Close();
		query_aktivnosti->SQL->Clear();

		query_aktivnosti->SQL->Add(
			"DELETE FROM aktivnost "
			"WHERE id_aktivnost = :id"
		);

		query_aktivnosti
			->ParamByName("id")
			->AsInteger =
			idAktivnost;

		query_aktivnosti->ExecSQL();
        data_module->connection->Commit();

		ShowMessage(
			L"Aktivnost je uspješno obrisana."
		);

		osvjeziPopisAktivnosti();
	}
	catch (const Exception &e)
	{
		if (data_module->connection->InTransaction)
		{
			data_module->connection->Rollback();
		}

		ShowMessage(
			L"Greška prilikom brisanja:\n" +
			e.Message
		);
	}
}
