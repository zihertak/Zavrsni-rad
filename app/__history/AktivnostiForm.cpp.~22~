void Tform_aktivnosti::ucitajPodrucja()
{
	combo_podrucje->Items->Clear();
	combo_podrucje->Items->Add(L"Sva područja");

	query_podrucja->Close();
	query_podrucja->SQL->Clear();

	query_podrucja->SQL->Add(
		"SELECT id_podrucje_razvoja, naziv "
		"FROM podrucje_razvoja "
		"ORDER BY naziv ASC"
	);

	query_podrucja->Open();

	while (!query_podrucja->Eof)
	{
		combo_podrucje->Items->Add(
			query_podrucja
				->FieldByName("naziv")
				->AsString
		);

		query_podrucja->Next();
	}

	combo_podrucje->ItemIndex = 0;
}
//---------------------------------------------------------------------------
void Tform_aktivnosti::osvjeziPopisAktivnosti()
{
	String pretraga = edit_pretraga->Text.Trim();
	String podrucje = "";
	String sortiranje = "a.naziv ASC";

	if (combo_podrucje->ItemIndex > 0)
	{
		podrucje = combo_podrucje->Text;
	}

    switch (combo_sortiranje->ItemIndex)
	{
	case 0:
		sortiranje = "a.naziv ASC";
		break;

	case 1:
		sortiranje = "a.naziv DESC";
		break;

	case 2:
		sortiranje = "a.trajanje_minuta ASC";
		break;

	case 3:
		sortiranje = "a.trajanje_minuta DESC";
		break;

	case 4:
		sortiranje = "a.dob_od ASC";
		break;

	case 5:
		sortiranje = "a.dob_od DESC";
		break;
	}

	query_aktivnosti->Close();
	query_aktivnosti->SQL->Clear();

	query_aktivnosti->SQL->Add(
		"SELECT "
		"a.id_aktivnost, "
		"a.naziv, "
		"CAST(a.opis AS CHAR(255)) AS opis, "
		"a.trajanje_minuta, "
        "CONCAT(a.razina_tezine, ' - ', "
		"CASE a.razina_tezine "
		"WHEN 1 THEN 'Vrlo jednostavna' "
		"WHEN 2 THEN 'Jednostavna' "
		"WHEN 3 THEN 'Srednja' "
		"WHEN 4 THEN 'Napredna' "
		"WHEN 5 THEN 'Vrlo napredna' "
		"END) AS tezina, "
		"CONCAT(a.dob_od, ' - ', a.dob_do, ' godina') AS dob, "


		"GROUP_CONCAT("
		"DISTINCT pr.naziv "
		"ORDER BY pr.naziv "
		"SEPARATOR ', '"
		") AS podrucja_razvoja "

		"FROM aktivnost a "

		"LEFT JOIN aktivnost_podrucje apr "
		"ON apr.id_aktivnost = a.id_aktivnost "

		"LEFT JOIN podrucje_razvoja pr "
		"ON pr.id_podrucje_razvoja = apr.id_podrucje_razvoja "

		"WHERE 1 = 1 "
	);

	if (!pretraga.IsEmpty())
	{
		query_aktivnosti->SQL->Add(
			"AND ("
			"a.naziv LIKE :pretraga "
			"OR a.opis LIKE :pretraga "
			"OR pr.naziv LIKE :pretraga"
			") "
		);

		query_aktivnosti
			->ParamByName("pretraga")
			->AsString =
			"%" + pretraga + "%";
	}

	if (!podrucje.IsEmpty())
	{
		query_aktivnosti->SQL->Add(
			"AND pr.naziv = :podrucje "
		);

		query_aktivnosti
			->ParamByName("podrucje")
			->AsString =
			podrucje;
	}

	query_aktivnosti->SQL->Add(
	"GROUP BY "
	"a.id_aktivnost, "
	"a.naziv, "
	"a.opis, "
	"a.trajanje_minuta, "
	"a.razina_tezine, "
	"a.dob_od, "
	"a.dob_do "
	);

	query_aktivnosti->SQL->Add(
		"ORDER BY " + sortiranje
	);

	query_aktivnosti->Open();

	postaviIzgledGrida();
}

