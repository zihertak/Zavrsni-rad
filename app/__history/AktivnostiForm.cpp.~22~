		return;
	}

	int idAktivnost =
		query_aktivnosti
			->FieldByName("id_aktivnost")
			->AsInteger;

	form_aktivnost_unos
		->pripremiZaUredjivanje(idAktivnost);

	if (form_aktivnost_unos->ShowModal() == mrOk)
	{
		osvjeziPopisAktivnosti();
	}
}

void Tform_aktivnosti::primijeniPrava()
{
	TKorisnickaPrava prava(
		data_module->currentUserUloga
	);
	button_dodaj->Enabled =
		prava.dodajAktivnost();
	button_uredi->Enabled =
		prava.urediAktivnost();
	button_obrisi->Enabled =
		prava.obrisiAktivnost();
	button_korisnici->Visible = prava.korisnici();
}

