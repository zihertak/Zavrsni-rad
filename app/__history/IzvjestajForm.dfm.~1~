  object query_izv_skupine: TFDQuery
    Connection = data_module.connection
    SQL.Strings = (
      'SELECT'
      '    id_skupina,'
      '    naziv,'
      '    pedagoska_godina,'
      '    dob_od,'
      '    dob_do'
      'FROM skupina'
      'ORDER BY naziv ASC')
    Left = 64
    Top = 400
  end
  object query_izv_djeca: TFDQuery
    Connection = data_module.connection
    MasterSource = datasource_izv_skupine
    MasterFields = 'id_skupina'
    SQL.Strings = (
      'SELECT'
      '    id_dijete,'
      '    ime,'
      '    prezime,'
      '    datum_rodjenja,'
      '    spol,'
      '    id_skupina'
      'FROM dijete'
      'WHERE id_skupina = :id_skupina'
      'ORDER BY prezime ASC')
    Left = 128
    Top = 400
  end
  object query_izv_procjene: TFDQuery
    Connection = data_module.connection
    SQL.Strings = (
      'SELECT'
      '    rp.id_razvojni_pregled,'
      '    rp.datum,'
      '    (SELECT AVG(pp.razina)'
      '     FROM procjena_podrucja pp'
      '     WHERE pp.id_razvojni_pregled = rp.id_razvojni_pregled) AS prosjek'
      'FROM razvojni_pregled rp'
      'WHERE rp.id_dijete = :id_dijete'
      'ORDER BY rp.datum DESC, rp.id_razvojni_pregled DESC'
      'LIMIT 2')
    Left = 192
    Top = 400
  end
  object query_izv_odgojitelj: TFDQuery
    Connection = data_module.connection
    SQL.Strings = (
      'SELECT'
      '    k.ime,'
      '    k.prezime'
      'FROM korisnik k'
      'INNER JOIN uloga u ON u.id_uloga = k.id_uloga'
      'WHERE k.id_skupina = :id_skupina AND u.naziv = '#39'Odgojitelj'#39
      'LIMIT 1')
    Left = 256
    Top = 400
  end
  object datasource_izv_skupine: TDataSource
    DataSet = query_izv_skupine
    Left = 64
