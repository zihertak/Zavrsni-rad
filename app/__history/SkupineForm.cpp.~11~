	: TForm(Owner)
{
}
//---------------------------------------------------------------------------
void __fastcall Tform_skupine::FormShow(TObject *Sender)
{
	label_korisnik->Caption =
		"Korisnik: " +
		data_module->currentUserIme +
		" " +
		data_module->currentUserPrezime;

	label_uloga->Caption =
		"Uloga: " +
		data_module->currentUserUloga;

	ucitajPedagoskeGodine();

	combo_sortiranje->Items->Clear();
	combo_sortiranje->Items->Add(L"Naziv A-Ž");
	combo_sortiranje->Items->Add(L"Naziv Ž-A");
	combo_sortiranje->Items->Add(L"Najmlađa dob prvo");
	combo_sortiranje->Items->Add(L"Najstarija dob prvo");
	combo_sortiranje->Items->Add(L"Pedagoška godina uzlazno");
	combo_sortiranje->Items->Add(L"Pedagoška godina silazno");
	combo_sortiranje->ItemIndex = 0;

	osvjeziPopisSkupina();
}
