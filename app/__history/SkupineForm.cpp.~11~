{
	Application->Terminate();
}
//---------------------------------------------------------------------------
void Tform_skupine::ucitajPedagoskeGodine()
{
	combo_pedagoska_godina->Items->Clear();
	combo_pedagoska_godina->Items->Add(
		L"Sve godine"
	);
	query_pedagoske_godine->Close();
	query_pedagoske_godine->Open();
	while (!query_pedagoske_godine->Eof)
	{
		String pedagoskaGodina =
			query_pedagoske_godine
				->FieldByName("pedagoska_godina")
				->AsString;
		combo_pedagoska_godina->Items->Add(
			pedagoskaGodina
		);
		query_pedagoske_godine->Next();
	}
	combo_pedagoska_godina->ItemIndex = 0;
}

void Tform_skupine::osvjeziPopisSkupina()
{
	String pretraga = edit_pretraga->Text.Trim();
	String pedagoskaGodina = "";
	if (combo_pedagoska_godina->ItemIndex > 0)
	{
		pedagoskaGodina =
			combo_pedagoska_godina->Text;
	}
	query_skupine->Close();
	query_skupine->SQL->Clear();

	query_skupine->SQL->Add(
		"SELECT "
		"id_skupina, "
		"naziv, "
		"pedagoska_godina, "
		"dob_od, "
		"dob_do "
		"FROM skupina "
		"WHERE 1 = 1 "
	);
	if (!pretraga.IsEmpty())
	{
		query_skupine->SQL->Add(
			"AND naziv LIKE :pretraga "
		);
		query_skupine
			->ParamByName("pretraga")
			->AsString =
			"%" + pretraga + "%";
	}
	if (!pedagoskaGodina.IsEmpty())
	{
		query_skupine->SQL->Add(
			"AND pedagoska_godina = :pedagoska_godina "
		);
		query_skupine
			->ParamByName("pedagoska_godina")
			->AsString =
			pedagoskaGodina;
	}
	switch (combo_sortiranje->ItemIndex)
	{
		case 0:
			query_skupine->SQL->Add(
				"ORDER BY naziv ASC"
			);
			break;
		case 1:
			query_skupine->SQL->Add(
				"ORDER BY naziv DESC"
			);
			break;
		case 2:
			query_skupine->SQL->Add(
				"ORDER BY dob_od ASC, dob_do ASC"
			);
			break;
		case 3:
			query_skupine->SQL->Add(
				"ORDER BY dob_od DESC, dob_do DESC"
			);
			break;
		case 4:
			query_skupine->SQL->Add(
				"ORDER BY pedagoska_godina ASC, naziv ASC"
			);
			break;
		case 5:
			query_skupine->SQL->Add(
				"ORDER BY pedagoska_godina DESC, naziv ASC"
			);
			break;
		default:
			query_skupine->SQL->Add(
				"ORDER BY naziv ASC"
			);
			break;
	}
	query_skupine->Open();
	postaviIzgledGrida();
}

void Tform_skupine::postaviIzgledGrida()
{
	query_skupine->FieldByName("id_skupina")->Visible = false;
	query_skupine->FieldByName("naziv")->DisplayLabel = L"Naziv";
	query_skupine->FieldByName("naziv")->DisplayWidth = 25;
	query_skupine->FieldByName("pedagoska_godina")->DisplayLabel = L"Pedagoška godina";
	query_skupine->FieldByName("pedagoska_godina")->DisplayWidth = 25;
	query_skupine->FieldByName("dob_od")->DisplayLabel = L"Dob od";
	query_skupine->FieldByName("dob_od")->DisplayWidth = 12;
	query_skupine->FieldByName("dob_do")->DisplayLabel = L"Dob do";
    query_skupine->FieldByName("dob_do")->DisplayWidth = 12;
}
void __fastcall Tform_skupine::edit_pretragaChange(TObject *Sender)
{
    osvjeziPopisSkupina();
}
//---------------------------------------------------------------------------
void __fastcall Tform_skupine::combo_pedagoska_godinaChange(TObject *Sender)
{
    osvjeziPopisSkupina();
}
//---------------------------------------------------------------------------
void __fastcall Tform_skupine::combo_sortiranjeChange(TObject *Sender)
{
    osvjeziPopisSkupina();
}
//---------------------------------------------------------------------------
void __fastcall Tform_skupine::button_dodajClick(TObject *Sender)
{
    form_skupina_unos->pripremiZaDodavanje();
	if (form_skupina_unos->ShowModal() == mrOk)
	{
		osvjeziPopisSkupina();
		ucitajPedagoskeGodine();
	}
}
