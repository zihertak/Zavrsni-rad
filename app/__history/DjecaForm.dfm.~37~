  object query_djeca: TFDQuery
    OnCalcFields = query_djecaCalcFields
    Connection = data_module.connection
    SQL.Strings = (
      'SELECT'
      '    d.id_dijete,'
      '    d.ime,'
      '    d.prezime,'
      '    d.datum_rodjenja,'
      '    s.naziv AS skupina'
      'FROM dijete d'
