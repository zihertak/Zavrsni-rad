//---------------------------------------------------------------------------
void __fastcall Tform_korisnici::button_urediClick(TObject *Sender)
{
	if (query_korisnici->IsEmpty())
    {
        ShowMessage(
            L"Odaberite korisnika kojeg želite urediti."
        );
        return;
    }

    int idKorisnik =
        query_korisnici
            ->FieldByName("id_korisnik")
            ->AsInteger;

    form_korisnik_unos
        ->pripremiZaUredjivanje(idKorisnik);

    if (form_korisnik_unos->ShowModal() == mrOk)
    {
        osvjeziPopisKorisnika();
	}
}
