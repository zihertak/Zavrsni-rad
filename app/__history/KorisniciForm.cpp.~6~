void Tform_korisnici::ucitajUloge()
{
    combo_uloga->Items->Clear();

    combo_uloga->Items->AddObject(
        L"Sve uloge",
        reinterpret_cast<TObject*>(0)
    );

    query_uloge->Close();
    query_uloge->SQL->Clear();

    query_uloge->SQL->Add(
        L"SELECT id_uloga, naziv "
        L"FROM uloga "
        L"ORDER BY naziv"
    );

    query_uloge->Open();

    while (!query_uloge->Eof)
    {
        String naziv =
            query_uloge
                ->FieldByName(L"naziv")
                ->AsWideString;

        int idUloga =
            query_uloge
                ->FieldByName(L"id_uloga")
                ->AsInteger;

        combo_uloga->Items->AddObject(
            naziv,
			reinterpret_cast<TObject*>(
                static_cast<NativeInt>(idUloga)
            )
        );

        query_uloge->Next();
    }

    query_uloge->Close();
    combo_uloga->ItemIndex = 0;
}

void Tform_korisnici::osvjeziPopisKorisnika()
{
    String pretraga = edit_pretraga->Text.Trim();

    NativeInt idUloga = 0;

    if (combo_uloga->ItemIndex >= 0)
    {
        idUloga = reinterpret_cast<NativeInt>(
            combo_uloga->Items->Objects[
                combo_uloga->ItemIndex
            ]
        );
    }

    query_korisnici->Close();
    query_korisnici->SQL->Clear();

    query_korisnici->SQL->Add(
        L"SELECT "
        L"    k.id_korisnik, "
        L"    k.ime, "
        L"    k.prezime, "
        L"    k.username, "
        L"    k.id_uloga, "
		L"    k.id_skupina, "
		L"    k.aktivan, "
        L"    u.naziv AS naziv_uloge, "
		L"    s.naziv AS naziv_skupine "
        L"    CASE "
		L"    WHEN k.aktivan = 1 THEN 'Aktivan' "
		L"    ELSE 'Neaktivan' "
		L"    END AS status_korisnika
        L"FROM korisnik k "
        L"INNER JOIN uloga u "
        L"    ON u.id_uloga = k.id_uloga "
        L"LEFT JOIN skupina s "
        L"    ON s.id_skupina = k.id_skupina "
        L"WHERE 1 = 1 "
    );

    if (!pretraga.IsEmpty())
    {
        query_korisnici->SQL->Add(
            L"AND ("
            L"    k.ime LIKE :pretraga "
            L"    OR k.prezime LIKE :pretraga "
            L"    OR k.username LIKE :pretraga"
            L") "
        );

        query_korisnici
            ->ParamByName(L"pretraga")
            ->AsWideString =
            L"%" + pretraga + L"%";
    }

    if (idUloga != 0)
    {
        query_korisnici->SQL->Add(
            L"AND k.id_uloga = :id_uloga "
        );

        query_korisnici
            ->ParamByName(L"id_uloga")
            ->AsInteger =
            static_cast<int>(idUloga);
    }

    switch (combo_sortiranje->ItemIndex)
    {
        case 0:
            query_korisnici->SQL->Add(
                L"ORDER BY k.prezime ASC, k.ime ASC"
            );
            break;

        case 1:
            query_korisnici->SQL->Add(
                L"ORDER BY k.prezime DESC, k.ime DESC"
            );
            break;

        case 2:
            query_korisnici->SQL->Add(
                L"ORDER BY k.ime ASC, k.prezime ASC"
            );
            break;

        case 3:
            query_korisnici->SQL->Add(
                L"ORDER BY k.ime DESC, k.prezime DESC"
            );
            break;

        case 4:
            query_korisnici->SQL->Add(
                L"ORDER BY k.username ASC"
            );
            break;

        case 5:
            query_korisnici->SQL->Add(
                L"ORDER BY k.username DESC"
            );
            break;

        case 6:
            query_korisnici->SQL->Add(
                L"ORDER BY u.naziv ASC, "
                L"k.prezime ASC, k.ime ASC"
            );
			break;

        case 7:
			query_korisnici->SQL->Add(
				L"ORDER BY k.aktivan DESC, "
				L"k.prezime ASC, k.ime ASC"
			);
			break;

        default:
            query_korisnici->SQL->Add(
                L"ORDER BY k.prezime ASC, k.ime ASC"
            );
            break;
    }

    query_korisnici->Open();
	postaviIzgledGrida();
}

void Tform_korisnici::postaviIzgledGrida()
{
    query_korisnici
        ->FieldByName(L"id_korisnik")
        ->Visible = false;

    query_korisnici
        ->FieldByName(L"id_uloga")
        ->Visible = false;

    query_korisnici
        ->FieldByName(L"id_skupina")
        ->Visible = false;

    query_korisnici
        ->FieldByName(L"ime")
        ->DisplayLabel = L"Ime";

    query_korisnici
        ->FieldByName(L"ime")
        ->DisplayWidth = 18;

    query_korisnici
        ->FieldByName(L"prezime")
        ->DisplayLabel = L"Prezime";

    query_korisnici
        ->FieldByName(L"prezime")
        ->DisplayWidth = 22;

    query_korisnici
        ->FieldByName(L"username")
        ->DisplayLabel = L"Korisničko ime";

    query_korisnici
        ->FieldByName(L"username")
        ->DisplayWidth = 20;

    query_korisnici
        ->FieldByName(L"naziv_uloge")
        ->DisplayLabel = L"Uloga";

    query_korisnici
        ->FieldByName(L"naziv_uloge")
        ->DisplayWidth = 20;

    query_korisnici
        ->FieldByName(L"naziv_skupine")
        ->DisplayLabel = L"Skupina";

    query_korisnici
		->FieldByName(L"naziv_skupine")
		->DisplayWidth = 20;

    query_korisnici
		->FieldByName(L"aktivan")
		->Visible = false;

    query_korisnici
		->FieldByName(L"status_korisnika")
		->DisplayLabel = L"Status";

	query_korisnici
		->FieldByName(L"status_korisnika")
		->DisplayWidth = 12;

	query_korisnici
		->FieldByName(L"status_korisnika")
		->Alignment = taCenter;
}
